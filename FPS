-- Função para substituir Hit Sound CORRETAMENTE
function AHG.ReplaceHitSound(sound)
    if sound:IsA("Sound") and sound.Name == "HitSound" then
        -- Salvar SoundId original apenas uma vez
        if not AHG.OriginalHitSounds[sound] then
            AHG.OriginalHitSounds[sound] = sound.SoundId
        end
        
        if AHG.HitSoundEnabled then
            -- SUBSTITUIR o SoundId
            sound.SoundId = AHG.HitSoundID
            sound.Volume = AHG.HitSoundVolume
        else
            -- RESTAURAR o SoundId original
            if AHG.OriginalHitSounds[sound] then
                sound.SoundId = AHG.OriginalHitSounds[sound]
            end
        end
    end
end

-- Aplicar nos sons existentes
function AHG.ReplaceAllHitSounds()
    for _, descendant in pairs(game:GetDescendants()) do
        AHG.ReplaceHitSound(descendant)
    end
end

