local IconCache = {}

local function NormalizeIcon(a, b)
	local asset, rect
	if type(a) == "table" then
		asset = a[1] or a.Image or a.Asset
		rect = type(a[2]) == "table" and a[2] or a
	elseif type(a) == "string" then
		asset = a
		rect = type(b) == "table" and b or nil
	end
	if type(asset) ~= "string" or asset == "" then
		return nil
	end
	local size, pos
	if rect then
		size = rect.ImageRectSize or rect.RectSize
		pos = rect.ImageRectPosition or rect.ImageRectOffset or rect.Position
	end
	return { Image = asset, Size = size, Pos = pos }
end

local function LookupIcon(name)
	if not WindCreator then
		return nil
	end
	local fns = { WindCreator.Icon, WindCreator.Icons and WindCreator.Icons.Icon }
	for i = 1, 2 do
		local fn = fns[i]
		if type(fn) == "function" then
			local ok, a, b = pcall(fn, name)
			if ok then
				local d = NormalizeIcon(a, b)
				if d then
					return d
				end
			end
		end
	end
	return nil
end

local function ResolveIcon(kind)
	if IconCache[kind] ~= nil then
		return IconCache[kind] or nil
	end
	local d
	for _, name in ipairs(ICON_NAMES[kind] or { kind }) do
		d = LookupIcon(name)
		if d then
			break
		end
	end
	IconCache[kind] = d or false
	return d
end

local function MakeIcon(parent, kind, size, color)
	local root = New("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		Parent = parent,
	})
	local rootScale = New("UIScale", { Parent = root })
	local img = New("ImageLabel", {
		Name = "Glyph",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ImageColor3 = color,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	local d = ResolveIcon(kind)
	if d then
		img.Image = d.Image
		if d.Size then
			img.ImageRectSize = d.Size
		end
		if d.Pos then
			img.ImageRectOffset = d.Pos
		end
	end

	local cur = color
	local function apply(c)
		cur = c
		img.ImageColor3 = c
	end

	local nv = Instance.new("NumberValue")
	local from, to = color, color
	local active
	nv.Changed:Connect(function(v)
		apply(from:Lerp(to, v))
	end)

	local icon = { Root = root }
	local shown = true
	function icon.SetColor(c)
		if active then
			active:Cancel()
		end
		apply(c)
	end
	function icon.TweenColor(c, t)
		if c == cur then
			return
		end
		if active then
			active:Cancel()
		end
		from, to = cur, c
		nv.Value = 0
		active = TweenService:Create(nv, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 1 })
		active:Play()
	end
	function icon.Pop(from_)
		rootScale.Scale = from_ or 1.35
		Tween(rootScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	function icon.Show(on, instant)
		if on == shown then
			return
		end
		shown = on
		if on then
			root.Visible = true
			if instant then
				rootScale.Scale = 1
			else
				rootScale.Scale = 0.3
				Tween(rootScale, 0.24, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		elseif instant then
			root.Visible = false
		else
			Tween(rootScale, 0.12, { Scale = 0.3 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.13, function()
				if not shown then
					root.Visible = false
				end
			end)
		end
	end
	return icon
end

local function IconButton(parent, kind, w, iconSize, props)
	props = props or {}
	local h = props.Height or w
	local btn = New("TextButton", {
		Name = kind .. "Btn",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundTransparency = props.Bg and 0 or 1,
		BackgroundColor3 = props.Bg or COLORS.Card,
		Size = UDim2.fromOffset(w, h),
		Parent = parent,
	})
	if props.Radius then
		Corner(btn, props.Radius)
	end
	if props.StrokeColor then
		Stroke(btn, props.StrokeColor, 1.5)
	end
	local scale = New("UIScale", { Parent = btn })
	local ctl = { Button = btn, Kind = kind, Idle = props.Idle or COLORS.SubText, Hover = props.Hover or COLORS.Text }
	ctl.Icon = MakeIcon(btn, kind, iconSize, ctl.Idle)
	function ctl.SetIdle(c)
		ctl.Idle = c
		ctl.Icon.TweenColor(c, 0.15)
	end
	function ctl.SetKind(newKind)
		if ctl.Kind == newKind then
			return
		end
		ctl.Kind = newKind
		ctl.Icon.Root:Destroy()
		ctl.Icon = MakeIcon(btn, newKind, iconSize, ctl.Idle)
		ctl.Icon.Pop(0.55)
	end
	function ctl.Pop(from_)
		ctl.Icon.Pop(from_)
	end
	Bind(btn.MouseEnter, function()
		ctl.Icon.TweenColor(ctl.Hover, 0.12)
		if props.HoverScale then
			Tween(scale, 0.14, { Scale = props.HoverScale })
		end
	end)
	Bind(btn.MouseLeave, function()
		ctl.Icon.TweenColor(ctl.Idle, 0.12)
		Tween(scale, 0.14, { Scale = 1 })
	end)
	OnTap(btn, function()
		if props.OnClick then
			props.OnClick()
		end
	end, {
		Canvas = props.Canvas,
		OnDown = function()
			Tween(scale, 0.07, { Scale = 0.88 })
		end,
		OnUp = function()
			Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end,
	})
	return ctl
end

local function MakeSlider(parent, pos, size, init, onChange, onCommit, opts)
	opts = opts or {}
	local thickness = opts.Thickness or 4
	local knobSize = opts.KnobSize or 12
	local alwaysKnob = opts.AlwaysKnob == true
	local colorFn = opts.ColorFn
	local hit = New("TextButton", {
		Name = "Slider",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		Position = pos,
		Size = size,
		Parent = parent,
	})
	local bar = New("Frame", {
		BackgroundColor3 = COLORS.Track,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, thickness),
		Parent = hit,
	})
	Corner(bar, thickness / 2)
	local fill = New("Frame", {
		BackgroundColor3 = colorFn and colorFn(init) or COLORS.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(init, 1),
		Parent = bar,
	})
	Corner(fill, thickness / 2)
	local knob = New("Frame", {
		BackgroundColor3 = COLORS.Text,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(knobSize, knobSize),
		Parent = fill,
	})
	Corner(knob, knobSize / 2)
	local knobScale = New("UIScale", { Scale = alwaysKnob and 1 or 0, Parent = knob })

	local obj = { Value = init, Dragging = false, Hit = hit, Bar = bar }
	local activeInput
	local hovering = false

	local function paint(v)
		fill.Size = UDim2.fromScale(v, 1)
		if colorFn then
			fill.BackgroundColor3 = colorFn(v)
		end
	end

	local function visuals()
		local on = obj.Dragging or hovering
		Tween(knobScale, 0.16, { Scale = (alwaysKnob or on) and (on and 1.18 or 1) or 0 })
	end

	local function setFromX(x)
		local v = math.clamp((x - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
		if onChange then
			local o = onChange(v)
			if type(o) == "number" then
				v = o
			end
		end
		obj.Value = v
		paint(v)
	end

	function obj.Set(v)
		if obj.Dragging then
			return
		end
		v = math.clamp(v, 0, 1)
		obj.Value = v
		paint(v)
	end

	Bind(hit.MouseEnter, function()
		hovering = true
		visuals()
	end)
	Bind(hit.MouseLeave, function()
		hovering = false
		visuals()
	end)
	Bind(hit.InputBegan, function(input)
		if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
			obj.Dragging = true
			activeInput = input
			visuals()
			setFromX(input.Position.X)
		end
	end)
	Bind(UserInputService.InputChanged, function(input)
		if not obj.Dragging then
			return
		end
		if input == activeInput or (input.UserInputType == Enum.UserInputType.MouseMovement and activeInput.UserInputType == MOUSE1) then
			setFromX(input.Position.X)
		end
	end)
	Bind(UserInputService.InputEnded, function(input)
		if not obj.Dragging then
			return
		end
		local same = input == activeInput or (input.UserInputType == MOUSE1 and activeInput.UserInputType == MOUSE1)
		if same then
			obj.Dragging = false
			visuals()
			if onCommit then
				onCommit(obj.Value)
			end
		end
	end)
	return obj
end

local function ClampV(x, y, half)
	local vs = ViewSize()
	return Vector2.new(
		math.clamp(x, half.X, math.max(half.X, vs.X - half.X)),
		math.clamp(y, half.Y, math.max(half.Y, vs.Y - half.Y))
	)
end

local function Clamped(x, y, half)
	local v = ClampV(x, y, half)
	return UDim2.fromOffset(v.X, v.Y)
end

local Followers = {}

local function MakeDraggable(handle, target, getHalf, opts)
	opts = opts or {}
	local f = { Obj = target, Cur = Vector2.zero, Tar = Vector2.zero, Active = false, Dragging = false }
	Followers[#Followers + 1] = f
	local moved = false
	local startInput, startMouse, startPos

	Bind(handle.InputBegan, function(input)
		if input.UserInputType ~= MOUSE1 and input.UserInputType ~= TOUCH then
			return
		end
		if opts.Disabled and opts.Disabled() then
			return
		end
		f.Dragging = true
		moved = false
		startInput = input
		startMouse = Vector2.new(input.Position.X, input.Position.Y)
		startPos = Vector2.new(target.Position.X.Offset, target.Position.Y.Offset)
		f.Cur, f.Tar = startPos, startPos
		f.Active = false
		if opts.OnDown then
			opts.OnDown()
		end
	end)
	Bind(UserInputService.InputChanged, function(input)
		if not f.Dragging then
			return
		end
		if input == startInput or (input.UserInputType == Enum.UserInputType.MouseMovement and startInput.UserInputType == MOUSE1) then
			local d = Vector2.new(input.Position.X, input.Position.Y) - startMouse
			if not moved and d.Magnitude > (opts.Slop or 8) then
				moved = true
			end
			if moved then
				f.Tar = ClampV(startPos.X + d.X, startPos.Y + d.Y, getHalf())
				f.Active = true
			end
		end
	end)
	Bind(UserInputService.InputEnded, function(input)
		if not f.Dragging then
			return
		end
		local same = input == startInput or (input.UserInputType == MOUSE1 and startInput.UserInputType == MOUSE1)
		if same then
			f.Dragging = false
			if opts.OnUp then
				opts.OnUp(moved)
			end
			if not moved and opts.OnClick then
				opts.OnClick()
			end
		end
	end)
	return f
end

