local function PickNext(dir, auto)
	if dir > 0 and #Queue > 0 then
		return table.remove(Queue, 1)
	end
	local list = Context or Tracks
	local n = #list
	if n == 0 then
		return nil
	end
	if Shuffle and n > 1 and dir > 0 then
		if #Bag == 0 then
			if BagUsed and auto and RepeatMode == 0 then
				BagUsed = false
				return nil
			end
			for _, t in ipairs(list) do
				if t ~= Current then
					Bag[#Bag + 1] = t
				end
			end
			for i = #Bag, 2, -1 do
				local j = math.random(i)
				Bag[i], Bag[j] = Bag[j], Bag[i]
			end
			BagUsed = true
		end
		return table.remove(Bag)
	end
	local idx = Current and table.find(list, Current) or 0
	local ni = idx + dir
	if ni > n then
		if RepeatMode == 1 or not auto then
			ni = 1
		else
			return nil
		end
	end
	if ni < 1 then
		ni = n
	end
	return list[ni]
end

local function FadeIn(snd)
	local target = EffVolume()
	snd.Volume = 0
	local tw = Tween(snd, CONFIG.FadeIn, { Volume = target }, Enum.EasingStyle.Quad)
	tw.Completed:Connect(function()
		if snd.Parent then
			snd.Volume = EffVolume()
		end
	end)
end

local function GetSound(track)
	local snd = track.Sound
	if snd and snd.Parent then
		return snd
	end
	snd = New("Sound", {
		Name = "Track_" .. tostring(track.Title),
		Volume = EffVolume(),
		Looped = false,
		SoundId = "rbxassetid://" .. IdStr(track.Id),
		Parent = SoundFolder,
	})
	pcall(function()
		snd.PlaybackSpeed = Speed
	end)
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "NexvyrEQ"
	eq.Parent = snd
	track.EQ = eq
	ApplyEQ(track)
	track.Sound = snd
	Bind(snd.Ended, function()
		if snd ~= Music or LoadingNow or not Intent or RepeatMode == 2 then
			return
		end
		if SleepEnd then
			SleepEnd = false
			Intent = false
			UpdatePlayState()
			SetStatus("Temporizador finalizado", 2)
			return
		end
		Advance(1, true)
	end)
	Bind(snd:GetPropertyChangedSignal("Playing"), function()
		if track == Current then
			RefreshItem(track)
		end
	end)
	return snd
end

function LoadTrack(track, autoplay, skipHistory)
	if not track then
		return
	end
	LoadToken += 1
	local token = LoadToken
	if not skipHistory and Current and Current ~= track then
		History[#History + 1] = Current
		if #History > 50 then
			table.remove(History, 1)
		end
	end
	local prev = Music
	pcall(function()
		prev:Stop()
	end)
	local snd = GetSound(track)
	Music = snd
	Current = track
	LoadedTrack = track
	Data.LastTrack = track.Title
	Data.LastPos = 0
	Intent = autoplay and true or false
	snd.Volume = EffVolume()
	snd.Looped = (RepeatMode == 2)
	pcall(function()
		snd.PlaybackSpeed = Speed
	end)
	pcall(function()
		snd.TimePosition = 0
	end)
	if Intent then
		Data.Plays[track.Title] = (Data.Plays[track.Title] or 0) + 1
		Data.Last[track.Title] = os.time()
		SaveSoon()
	end
	local ready = snd.IsLoaded and snd.TimeLength > 0
	LoadingNow = not ready
	UpdateNowPlaying()
	UpdatePlayState()

	if ready then
		track.Failed = false
		FailStreak = 0
		SetStatus(nil)
		RefreshItem(track)
		UpdateTimes(0)
		if Intent then
			FadeIn(snd)
			snd:Play()
		end
		return
	end

	SetStatus("Cargando")
	if Intent then
		pcall(function()
			snd:Play()
		end)
	end
	task.spawn(function()
		local t0 = os.clock()
		while token == LoadToken and not (snd.IsLoaded and snd.TimeLength > 0) and os.clock() - t0 < 12 do
			task.wait(0.05)
		end
		if token ~= LoadToken then
			return
		end
		LoadingNow = false
		if snd.IsLoaded and snd.TimeLength > 0 then
			track.Failed = false
			FailStreak = 0
			SetStatus(nil)
			RefreshItem(track)
			UpdateTimes(0)
			if Intent then
				FadeIn(snd)
				if not snd.IsPlaying then
					snd:Play()
				end
			else
				pcall(function()
					snd:Pause()
				end)
			end
		else
			track.Failed = true
			FailStreak += 1
			SetStatus("No disponible")
			RefreshItem(track)
			if Intent and FailStreak < #Tracks then
				task.wait(1.2)
				if token == LoadToken then
					local nxt = PickNext(1, true)
					if nxt and nxt ~= track then
						LoadTrack(nxt, true)
						return
					end
				end
			end
			Intent = false
			pcall(function()
				snd:Stop()
			end)
			UpdatePlayState()
		end
	end)
end

function SelectTrack(track, autoplay)
	LoadTrack(track, autoplay)
end

function Advance(dir, auto)
	local nxt = PickNext(dir, auto)
	if not nxt then
		Intent = false
		pcall(function()
			Music:Stop()
		end)
		Music.TimePosition = 0
		U.ProgressSlider.Set(0)
		U.MiniSlider.Set(0)
		U.TimeL.Text = "0:00"
		UpdatePlayState()
		return
	end
	FailStreak = 0
	LoadTrack(nxt, true)
end

function TogglePlay()
	if not Current then
		local list = Context or Tracks
		if list[1] then
			FailStreak = 0
			LoadTrack(list[1], true)
		end
		return
	end
	if Intent then
		Intent = false
		local snd = Music
		if LoadedTrack == Current and snd.TimeLength > 0 then
			Data.LastPos = snd.TimePosition
			SaveSoon()
		end
		Tween(snd, 0.18, { Volume = 0 }, Enum.EasingStyle.Quad)
		task.delay(0.19, function()
			if not Intent and Music == snd then
				pcall(function()
					snd:Pause()
				end)
				snd.Volume = EffVolume()
			end
		end)
	else
		if LoadedTrack ~= Current or Current.Failed then
			FailStreak = 0
			LoadTrack(Current, true, true)
			return
		end
		Intent = true
		pcall(function()
			Music:Play()
		end)
		FadeIn(Music)
	end
	UpdatePlayState()
end

