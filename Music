local function MakeChips(names, y, onPick)
	local row = New("Frame", {
		BackgroundTransparency = 1,
		Position = P(219, y),
		Size = UDim2.fromOffset(586, 30),
		Visible = false,
		Parent = U.Window,
	})
	local obj = { Row = row, Active = 1 }
	local chips = {}
	local x = 0
	for i, name in ipairs(names) do
		local w = (utf8.len(name) or #name) * 7.6 + 30
		local btn = New("TextButton", {
			AutoButtonColor = false,
			BackgroundColor3 = COLORS.Field,
			BorderSizePixel = 0,
			Text = name,
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextColor3 = COLORS.SubText,
			Position = P(x, 0),
			Size = UDim2.fromOffset(w, 30),
			Parent = row,
		})
		Corner(btn, 15)
		local st = Stroke(btn, COLORS.Stroke, 1)
		local sc = New("UIScale", { Parent = btn })
		chips[i] = { Btn = btn, Stroke = st }
		Bind(btn.MouseEnter, function()
			Tween(sc, 0.12, { Scale = 1.05 })
		end)
		Bind(btn.MouseLeave, function()
			Tween(sc, 0.12, { Scale = 1 })
		end)
		Bind(btn.MouseButton1Down, function()
			Tween(sc, 0.07, { Scale = 0.94 })
		end)
		Bind(btn.Activated, function()
			Tween(sc, 0.25, { Scale = 1.05 }, Enum.EasingStyle.Back)
			obj.Set(i, true)
		end)
		x += w + 8
	end
	function obj.Paint()
		for i, c in ipairs(chips) do
			local on = i == obj.Active
			Tween(c.Btn, 0.18, {
				BackgroundColor3 = on and COLORS.Accent or COLORS.Field,
				TextColor3 = on and COLORS.Black or COLORS.SubText,
			}, Enum.EasingStyle.Quad)
			Tween(c.Stroke, 0.18, { Transparency = on and 1 or 0 }, Enum.EasingStyle.Quad)
		end
	end
	function obj.Set(i, fire)
		obj.Active = i
		obj.Paint()
		if fire and onPick then
			onPick(i)
		end
	end
	obj.Paint()
	return obj
end

