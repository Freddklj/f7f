local function ExecutorInfo()
	local name, ver
	if type(identifyexecutor) == "function" then
		local ok, n, v = pcall(identifyexecutor)
		if ok then
			name, ver = n, v
		end
	end
	if not name and type(getexecutorname) == "function" then
		local ok, n = pcall(getexecutorname)
		if ok then
			name = n
		end
	end
	if type(name) ~= "string" or name == "" then
		return "No detectado"
	end
	if type(ver) == "string" and ver ~= "" then
		return name .. " " .. ver
	end
	return name
end

local function CopyText(text, what)
	local ok = false
	if type(setclipboard) == "function" then
		ok = pcall(setclipboard, text)
	end
	SetStatus(ok and (what .. " copiado") or text, 1.6)
end

