function SortList(list)
	if SortMode == 2 then
		table.sort(list, function(a, b)
			return string.lower(a.Title) < string.lower(b.Title)
		end)
	elseif SortMode == 3 then
		table.sort(list, function(a, b)
			local pa, pb = Data.Plays[a.Title] or 0, Data.Plays[b.Title] or 0
			if pa ~= pb then
				return pa > pb
			end
			return string.lower(a.Title) < string.lower(b.Title)
		end)
	elseif SortMode == 4 then
		table.sort(list, function(a, b)
			local la, lb = Data.Last[a.Title] or 0, Data.Last[b.Title] or 0
			if la ~= lb then
				return la > lb
			end
			return string.lower(a.Title) < string.lower(b.Title)
		end)
	end
end

function ApplyFilter(animate)
	local order = {}
	local pid = CurrentPlaylistId()
	local hist = SearchHistoryMode()
	if View == "home" then
		if HomeTab == "queue" then
			local seen = {}
			if Current then
				order[#order + 1] = Current
				seen[Current] = true
			end
			for _, t in ipairs(Queue) do
				if not seen[t] then
					order[#order + 1] = t
					seen[t] = true
				end
			end
			local list = Context or Tracks
			local n = #list
			local idx = Current and table.find(list, Current) or 0
			for i = 1, n do
				local t = list[((idx + i - 1) % n) + 1]
				if t and not seen[t] then
					order[#order + 1] = t
					seen[t] = true
				end
			end
		elseif HomeTab == "recent" then
			for _, t in ipairs(Tracks) do
				if (Data.Last[t.Title] or 0) > 0 then
					order[#order + 1] = t
				end
			end
			table.sort(order, function(a, b)
				return (Data.Last[a.Title] or 0) > (Data.Last[b.Title] or 0)
			end)
		else
			for _, t in ipairs(Tracks) do
				if (Data.Plays[t.Title] or 0) > 0 then
					order[#order + 1] = t
				end
			end
			table.sort(order, function(a, b)
				local pa, pb = Data.Plays[a.Title] or 0, Data.Plays[b.Title] or 0
				if pa ~= pb then
					return pa > pb
				end
				return a.Title < b.Title
			end)
		end
	elseif View == "search" then
		if not hist then
			local q = string.lower(U.SearchInput.Text or "")
			local chip = U.SearchChips.Active
			for _, t in ipairs(Tracks) do
				local artist = string.lower(t.Artist or CONFIG.DefaultArtist)
				local match = q == ""
					or string.find(string.lower(t.Title), q, 1, true) ~= nil
					or string.find(artist, q, 1, true) ~= nil
					or string.find(IdStr(t.Id), q, 1, true) ~= nil
				if match then
					local plays = Data.Plays[t.Title] or 0
					if chip == 1 or (chip == 2 and plays > 0) or (chip == 3 and plays == 0) or (chip == 4 and Data.Liked[t.Title]) then
						order[#order + 1] = t
					end
				end
			end
			if chip == 2 then
				table.sort(order, function(a, b)
					local pa, pb = Data.Plays[a.Title] or 0, Data.Plays[b.Title] or 0
					if pa ~= pb then
						return pa > pb
					end
					return a.Title < b.Title
				end)
			elseif q ~= "" then
				table.sort(order, function(a, b)
					local sa = string.find(string.lower(a.Title), q, 1, true) == 1 and 0 or 1
					local sb = string.find(string.lower(b.Title), q, 1, true) == 1 and 0 or 1
					if sa ~= sb then
						return sa < sb
					end
					return a.Title < b.Title
				end)
			end
			U.ResultLabel.Text = #order == 1 and "1 resultado" or (tostring(#order) .. " resultados")
		end
	elseif View == "liked" then
		for _, t in ipairs(Tracks) do
			if Data.Liked[t.Title] then
				order[#order + 1] = t
			end
		end
		table.sort(order, function(a, b)
			local la, lb = Data.Liked[a.Title] or 0, Data.Liked[b.Title] or 0
			if la ~= lb then
				return la > lb
			end
			return a.Title < b.Title
		end)
		SortList(order)
	elseif View == "hub" then
		for _, t in ipairs(Tracks) do
			order[#order + 1] = t
		end
		SortList(order)
	elseif pid then
		local pl = GetPlaylist(pid)
		if pl then
			order = PlaylistTracks(pl)
			SortList(order)
		end
	end

	ViewOrder = order
	local rank = {}
	for i, t in ipairs(order) do
		rank[t] = i
	end
	local showList = View ~= "library" and not ListHidden
	for _, t in ipairs(Tracks) do
		local ui = t.UI
		if ui then
			local r = rank[t]
			ui.Item.Visible = r ~= nil
			if r then
				ui.Item.LayoutOrder = r
				if animate then
					ui.Item.GroupTransparency = 0.75
					Tween(ui.Item, 0.2, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
				else
					ui.Item.GroupTransparency = 0
				end
			end
		end
	end

	ApplyLayout()

	if hist then
		U.EmptyLabel.Text = "Busca por título, artista o ID, o usa un filtro"
		U.EmptyLabel.Visible = #Data.Searches == 0 and not ListHidden
	elseif #order == 0 and View ~= "library" and View ~= "profile" then
		if View == "liked" then
			U.EmptyLabel.Text = "Aún no tienes canciones que te gusten"
		elseif View == "search" then
			U.EmptyLabel.Text = "Sin resultados"
		elseif View == "home" and HomeTab == "recent" then
			U.EmptyLabel.Text = "Aún no has escuchado nada"
		elseif View == "home" and HomeTab == "top" then
			U.EmptyLabel.Text = "Reproduce canciones para ver tu top"
		elseif pid then
			U.EmptyLabel.Text = "Esta playlist está vacía. Usa ⋯ para añadir canciones"
		else
			U.EmptyLabel.Text = "Sin canciones"
		end
		U.EmptyLabel.Visible = showList
	else
		U.EmptyLabel.Visible = false
	end

	for _, t in ipairs(Tracks) do
		RefreshItem(t)
	end
end
