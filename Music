function Relayout(W, H)
	W = math.floor(W + 0.5)
	H = math.floor(H + 0.5)
	WW, WH = W, H
	if not Fullscreen then
		Data.W, Data.H = W, H
	end
	local dx, dy = W - DW, H - DH
	U.Holder.Size = UDim2.fromOffset(W, H)
	for _, e in ipairs(Reg) do
		e.O.Position = UDim2.fromOffset(math.floor(e.X + e.sx * dx), math.floor(e.Y + e.sy * dy))
		if e.gw ~= 0 or e.gh ~= 0 then
			e.O.Size = UDim2.fromOffset(e.W + e.gw * dx, e.H + e.gh * dy)
		end
	end
	ApplyLayout()
end

function RefitFullscreen()
	local vs = ViewSize()
	local s = math.clamp(UserScale, CONFIG.MinScale, math.max(CONFIG.MinScale, FitScale(DW, DH)))
	U.HolderScale.Scale = s
	Relayout((vs.X - 16) / s, (vs.Y - 24) / s)
	U.Holder.Position = UDim2.fromOffset(vs.X / 2, vs.Y / 2)
end

function SetWindowScale(sc)
	if Fullscreen or FSBusy then
		return
	end
	UserScale = math.clamp(sc, CONFIG.MinScale, CONFIG.MaxScale)
	ApplyFit()
	Save()
	SetStatus("Escala " .. tostring(math.floor(U.HolderScale.Scale * 100 + 0.5)) .. "%", 1.4)
end

function ResetWindowSize()
	if Fullscreen or FSBusy then
		return
	end
	local c = U.Holder.Position
	local s0 = U.HolderScale.Scale
	local tlx, tly = c.X.Offset - WW * s0 / 2, c.Y.Offset - WH * s0 / 2
	Relayout(DW, DH)
	ApplyFit()
	local s = U.HolderScale.Scale
	U.Holder.Position = Clamped(tlx + WW * s / 2, tly + WH * s / 2, HolderHalf())
	Save()
	SetStatus("Tamaño restablecido", 1.4)
end

local FSRestore
function ToggleMaximize()
	if FSBusy or not Open then
		return
	end
	CloseMenu()
	FSBusy = true
	local vs = ViewSize()
	local sw, sh, ss = WW, WH, U.HolderScale.Scale
	local sp = Vector2.new(U.Holder.Position.X.Offset, U.Holder.Position.Y.Offset)
	local ew, eh, es, ep
	if not Fullscreen then
		FSRestore = { W = WW, H = WH, Pos = sp, Scale = UserScale }
		Fullscreen = true
		U.ResizeHandle.Visible = false
		es = math.clamp(UserScale, CONFIG.MinScale, math.max(CONFIG.MinScale, FitScale(DW, DH)))
		ew, eh = (vs.X - 16) / es, (vs.Y - 24) / es
		ep = Vector2.new(vs.X / 2, vs.Y / 2)
	else
		Fullscreen = false
		local r = FSRestore or { W = DW, H = DH, Pos = sp, Scale = UserScale }
		ew, eh = r.W, r.H
		es = math.clamp(r.Scale, CONFIG.MinScale, math.max(CONFIG.MinScale, FitScale(ew, eh)))
		ep = r.Pos
	end
	U.MaxBtn.SetKind(Fullscreen and "restore" or "maximize")
	local nv = Instance.new("NumberValue")
	local conn = nv.Changed:Connect(function(t)
		Relayout(sw + (ew - sw) * t, sh + (eh - sh) * t)
		U.HolderScale.Scale = ss + (es - ss) * t
		U.Holder.Position = UDim2.fromOffset(sp.X + (ep.X - sp.X) * t, sp.Y + (ep.Y - sp.Y) * t)
	end)
	local tw = TweenService:Create(nv, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Value = 1 })
	tw.Completed:Connect(function()
		conn:Disconnect()
		nv:Destroy()
		Relayout(ew, eh)
		U.HolderScale.Scale = es
		if Fullscreen then
			U.Holder.Position = UDim2.fromOffset(vs.X / 2, vs.Y / 2)
		else
			U.ResizeHandle.Visible = true
			U.Holder.Position = UDim2.fromOffset(ep.X, ep.Y)
			ClampHolder()
		end
		FSBusy = false
	end)
	tw:Play()
end

