function PrevAction()
	if Current and LoadedTrack == Current and Music.TimePosition > 3 then
		Music.TimePosition = 0
		return
	end
	local prevTrack
	while #History > 0 do
		local t = table.remove(History)
		if table.find(Tracks, t) then
			prevTrack = t
			break
		end
	end
	if prevTrack then
		LoadTrack(prevTrack, true, true)
	else
		local list = Context or Tracks
		local n = #list
		if n == 0 then
			return
		end
		local idx = Current and table.find(list, Current) or 1
		local ni = idx - 1
		if ni < 1 then
			ni = n
		end
		LoadTrack(list[ni], true)
	end
end

