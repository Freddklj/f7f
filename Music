local function WindowRel(obj)
	local sc = U.Window.AbsoluteSize.X / WW
	if sc <= 0 then
		sc = 1
	end
	return (obj.AbsolutePosition - U.Window.AbsolutePosition) / sc, obj.AbsoluteSize / sc
