local StatusToken = 0

function SetStatus(text, hold)
	StatusToken += 1
	local tk = StatusToken
	if text then
		U.PillText.Text = text
		U.Pill.Visible = true
		Tween(U.Pill, 0.2, { BackgroundTransparency = 0.3 }, Enum.EasingStyle.Quad)
		Tween(U.PillText, 0.2, { TextTransparency = 0 }, Enum.EasingStyle.Quad)
		if hold then
			task.delay(hold, function()
				if StatusToken == tk then
					Tween(U.Pill, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
					Tween(U.PillText, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
					task.delay(0.2, function()
						if StatusToken == tk then
							U.Pill.Visible = false
						end
					end)
				end
			end)
		end
	else
		Tween(U.Pill, 0.2, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		Tween(U.PillText, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
		task.delay(0.2, function()
			if StatusToken == tk then
				U.Pill.Visible = false
			end
		end)
	end
end

local function GetPlaylist(id)
	for _, pl in ipairs(Data.Playlists) do
		if pl.Id == id then
			return pl
		end
	end
	return nil
end

local function CurrentPlaylistId()
	local id = string.match(View, "^pl:(%d+)$")
	return id and tonumber(id) or nil
end

local function PlaylistHas(pl, track)
	return table.find(pl.Tracks, track.Title) ~= nil
end

local function PlaylistTracks(pl)
	local list = {}
	for _, name in ipairs(pl.Tracks) do
		local t = ByTitle[name]
		if t then
			list[#list + 1] = t
		end
	end
	return list
end

local function CreatePlaylist(name)
	local pl = { Id = Data.NextPlaylist, Name = name, Tracks = {} }
	Data.NextPlaylist += 1
	Data.Playlists[#Data.Playlists + 1] = pl
	Save()
	RebuildSidebar()
	RebuildLibrary()
	return pl
end

local function DeletePlaylist(id)
	for i, pl in ipairs(Data.Playlists) do
		if pl.Id == id then
			table.remove(Data.Playlists, i)
			break
		end
	end
	Save()
	local wasView = CurrentPlaylistId() == id
	RebuildSidebar()
	RebuildLibrary()
	if wasView then
		SetView("library")
	end
end

local function TogglePlaylistTrack(pl, track)
	local i = table.find(pl.Tracks, track.Title)
	if i then
		table.remove(pl.Tracks, i)
	else
		pl.Tracks[#pl.Tracks + 1] = track.Title
	end
	Save()
	RebuildLibrary()
	if CurrentPlaylistId() == pl.Id then
		ApplyFilter(false)
	end
end

local function PlayList(list)
	if #list == 0 then
		SetStatus("Lista vacía", 1.4)
		return
	end
	Context = table.clone(list)
	ResetBag()
	FailStreak = 0
	local first = list[1]
	if Shuffle and #list > 1 then
		first = list[math.random(#list)]
	end
	LoadTrack(first, true)
end

local function ShowCreatePlaylist(after)
	ShowDialog({
		Title = "Nueva playlist",
		Text = "Ponle un nombre a tu playlist.",
		Input = { Placeholder = "Nombre de la playlist", Default = "Mi playlist #" .. tostring(Data.NextPlaylist) },
		Cancel = "Cancelar",
		Confirm = "Crear",
		ConfirmStyle = "primary",
		OnConfirm = function(text)
			text = string.gsub(text or "", "^%s+", "")
			text = string.gsub(text, "%s+$", "")
			if text == "" then
				text = "Mi playlist #" .. tostring(Data.NextPlaylist)
			end
			local pl = CreatePlaylist(string.sub(text, 1, 32))
			if after then
				after(pl)
			else
				SetView("pl:" .. pl.Id)
			end
		end,
	})
end

