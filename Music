function PlayFromView(track)
	if View == "search" and (U.SearchInput.Text or "") ~= "" then
		AddSearch(U.SearchInput.Text)
	end
	if track == Current and not track.Failed then
		TogglePlay()
		return
	end
	FailStreak = 0
	ResetBag()
	if View == "home" and HomeTab == "queue" then
		Context = nil
	else
		Context = table.clone(ViewOrder)
	end
	local qi = table.find(Queue, track)
	if qi then
		table.remove(Queue, qi)
	end
	SelectTrack(track, true)
end

function TrackMenuItems(track)
	local liked = Data.Liked[track.Title] ~= nil
	local items = {}
	local function RefreshAll()
		for _, t in ipairs(Tracks) do
			RefreshItem(t)
		end
		if View == "home" and HomeTab == "queue" then
			ApplyFilter(false)
		end
	end
	items[#items + 1] = {
		Text = (track == Current and Intent) and "Pausar" or "Reproducir",
		Action = function()
			PlayFromView(track)
		end,
	}
	items[#items + 1] = {
		Text = "Reproducir a continuación",
		Action = function()
			local qi = table.find(Queue, track)
			if qi then
				table.remove(Queue, qi)
			end
			table.insert(Queue, 1, track)
			SetStatus("Se reproducirá a continuación", 1.6)
			RefreshAll()
		end,
	}
	if table.find(Queue, track) then
		items[#items + 1] = {
			Text = "Quitar de la cola",
			Action = function()
				local qi = table.find(Queue, track)
				if qi then
					table.remove(Queue, qi)
				end
				SetStatus("Quitada de la cola", 1.4)
				RefreshAll()
			end,
		}
	else
		items[#items + 1] = {
			Text = "Añadir a la cola",
			Action = function()
				Queue[#Queue + 1] = track
				SetStatus("Añadida a la cola", 1.4)
				RefreshAll()
			end,
		}
	end
	items[#items + 1] = { Divider = true }
	items[#items + 1] = {
		Text = liked and "Quitar de Me gusta" or "Guardar en Me gusta",
		Action = function()
			ToggleLike(track)
		end,
	}
	items[#items + 1] = {
		Text = "Añadir a playlist",
		Sub = function()
			local sub = {}
			for _, pl in ipairs(Data.Playlists) do
				sub[#sub + 1] = {
					Text = pl.Name,
					Check = PlaylistHas(pl, track),
					Action = function()
						TogglePlaylistTrack(pl, track)
						SetStatus(PlaylistHas(pl, track) and "Añadida a la playlist" or "Quitada de la playlist", 1.4)
					end,
				}
			end
			sub[#sub + 1] = { Divider = true }
			sub[#sub + 1] = {
				Text = "Nueva playlist",
				Action = function()
					ShowCreatePlaylist(function(pl)
						TogglePlaylistTrack(pl, track)
						SetStatus("Añadida a " .. pl.Name, 1.6)
					end)
				end,
			}
			return sub
		end,
	}
	local pid = CurrentPlaylistId()
	if pid then
		local pl = GetPlaylist(pid)
		if pl and PlaylistHas(pl, track) then
			items[#items + 1] = {
				Text = "Quitar de esta playlist",
				Action = function()
					TogglePlaylistTrack(pl, track)
				end,
			}
		end
	end
	items[#items + 1] = { Divider = true }
	items[#items + 1] = {
		Text = "Copiar ID",
		Action = function()
			CopyId(track)
		end,
	}
	return items
