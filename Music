local function AddSearch(term)
	term = string.gsub(term or "", "^%s+", "")
	term = string.gsub(term, "%s+$", "")
	if #term < 2 then
		return
	end
	local low = string.lower(term)
	for i = #Data.Searches, 1, -1 do
		if string.lower(Data.Searches[i]) == low then
			table.remove(Data.Searches, i)
		end
	end
	table.insert(Data.Searches, 1, string.sub(term, 1, 40))
	while #Data.Searches > 6 do
		table.remove(Data.Searches)
	end
	SaveSoon()
	RebuildHistory()
end

