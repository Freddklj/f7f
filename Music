local function RenderMenu(items)
	for _, c in ipairs(U.MenuFrame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local width = 244
	local y = 6
	for _, it in ipairs(items) do
		if it.Divider then
			New("Frame", {
				BackgroundColor3 = COLORS.Stroke,
				BorderSizePixel = 0,
				Position = P(10, y + 3),
				Size = UDim2.fromOffset(width - 20, 1),
				Parent = U.MenuFrame,
			})
			y += 7
		elseif it.Header then
			Label(U.MenuFrame, it.Text, 12, COLORS.SubText, Enum.Font.GothamBold, P(16, y), UDim2.fromOffset(width - 32, 24))
			y += 26
		else
			local btn = New("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = COLORS.PopupHover,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = P(6, y),
				Size = UDim2.fromOffset(width - 12, 36),
				Parent = U.MenuFrame,
			})
			Corner(btn, 8)
			local col = it.Danger and COLORS.Danger or (it.Disabled and COLORS.SubText or COLORS.SoftText)
			local tx = 12
			if it.Back then
				local bi = MakeIcon(btn, "back", 16, COLORS.SubText)
				bi.Root.Position = P(20, 18)
				tx = 36
			end
			Label(btn, it.Text, 14, col, Enum.Font.GothamMedium, P(tx, 0), UDim2.new(1, -(tx + 36), 1, 0))
			if it.Check then
				local ic = MakeIcon(btn, "check", 16, COLORS.Accent)
				ic.Root.Position = UDim2.new(1, -20, 0.5, 0)
			end
			if it.Sub then
				local ic = MakeIcon(btn, "chevron", 16, COLORS.SubText)
				ic.Root.Position = UDim2.new(1, -20, 0.5, 0)
			end
			btn.MouseEnter:Connect(function()
				Tween(btn, 0.1, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)
			end)
			btn.MouseLeave:Connect(function()
				Tween(btn, 0.12, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			end)
			btn.Activated:Connect(function()
				if it.Disabled then
					return
				end
				if it.Back then
					local prev = table.remove(MenuStack)
					if prev then
						RenderMenu(prev)
					end
					return
				end
				if it.Sub then
					MenuStack[#MenuStack + 1] = items
					local sub = it.Sub()
					local list = { { Text = it.Text, Back = true } }
					for _, s in ipairs(sub) do
						list[#list + 1] = s
					end
					RenderMenu(list)
					return
				end
				CloseMenu()
				if it.Action then
					task.defer(it.Action)
				end
			end)
			y += 38
		end
	end
	local height = y + 6
	U.MenuFrame.Size = UDim2.fromOffset(width, height)
	if MenuAnchor and MenuAnchor.Parent then
		local rel, sz = WindowRel(MenuAnchor)
		local x = MenuRight and (rel.X + sz.X - width) or rel.X
		local py = rel.Y + sz.Y + 6
		if py + height > WH - 10 then
			py = rel.Y - height - 6
		end
		x = math.clamp(x, 10, WW - width - 10)
		py = math.clamp(py, 10, WH - height - 10)
		U.MenuFrame.Position = UDim2.fromOffset(x, py)
	end
end

function OpenMenu(anchor, items, alignRight)
	table.clear(MenuStack)
	MenuAnchor, MenuRight = anchor, alignRight
	U.MenuLayer.Visible = true
	MenuOpen = true
	RenderMenu(items)
	U.MenuFrame.Visible = true
	U.MenuFrame.GroupTransparency = 1
	U.MenuScale.Scale = 0.94
	Tween(U.MenuFrame, 0.16, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
	Tween(U.MenuScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Quint)
end

function CloseMenu()
	if not MenuOpen then
		return
	end
	MenuOpen = false
	Tween(U.MenuFrame, 0.12, { GroupTransparency = 1 }, Enum.EasingStyle.Quad)
	Tween(U.MenuScale, 0.12, { Scale = 0.96 }, Enum.EasingStyle.Quad)
	task.delay(0.13, function()
		if not MenuOpen then
			U.MenuLayer.Visible = false
			U.MenuFrame.Visible = false
		end
	end)
end
Bind(U.MenuLayer.Activated, CloseMenu)

