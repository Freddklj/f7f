local function VolColor(v)
	local x = v * CONFIG.MaxVolume
	if x <= 1 then
		return COLORS.Accent
	elseif x <= 2 then
		return COLORS.Accent:Lerp(COLORS.Orange, x - 1)
	else
		return COLORS.Orange:Lerp(COLORS.Danger, math.clamp(x - 2, 0, 1))
	end
end

