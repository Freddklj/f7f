local DIGITS = {
	[Enum.KeyCode.Zero] = 0,
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

Bind(UserInputService.InputBegan, function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Escape then
		if DialogOpen then
			DialogCancelAction()
		elseif MenuOpen then
			CloseMenu()
		end
		return
	end
	if kc == CONFIG.ToggleKey and not DialogOpen and not UserInputService:GetFocusedTextBox() then
		if Open then
			CloseUI()
		else
			OpenUI()
		end
		return
	end
	if not Open or Busy or DialogOpen or MenuOpen then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end
	if not Over(U.Window) then
		return
	end
	local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	if kc == Enum.KeyCode.Space then
		TogglePlay()
	elseif kc == Enum.KeyCode.Right then
		if shift then
			Advance(1, false)
		elseif Current and LoadedTrack == Current and Music.TimeLength > 0 then
			Music.TimePosition = math.min(Music.TimeLength - 0.1, Music.TimePosition + CONFIG.SeekStep)
		end
	elseif kc == Enum.KeyCode.Left then
		if shift then
			PrevAction()
		elseif Current and LoadedTrack == Current and Music.TimeLength > 0 then
			Music.TimePosition = math.max(0, Music.TimePosition - CONFIG.SeekStep)
		end
	elseif kc == Enum.KeyCode.Up then
		SetVolume(Volume + CONFIG.WheelStep)
	elseif kc == Enum.KeyCode.Down then
		SetVolume(Volume - CONFIG.WheelStep)
	elseif kc == Enum.KeyCode.M then
		ToggleMute()
	elseif kc == Enum.KeyCode.S then
		ToggleShuffle()
	elseif kc == Enum.KeyCode.L then
		if Current then
			ToggleLike(Current)
		end
	elseif kc == Enum.KeyCode.LeftBracket or kc == Enum.KeyCode.RightBracket then
		local idx = 2
		for i, sp in ipairs(SPEEDS) do
			if sp == Speed then
				idx = i
			end
		end
		idx = math.clamp(idx + (kc == Enum.KeyCode.RightBracket and 1 or -1), 1, #SPEEDS)
		Speed = SPEEDS[idx]
		ApplySpeed()
		SaveSoon()
		SetStatus("Velocidad " .. tostring(Speed) .. "x", 1.4)
	elseif DIGITS[kc] ~= nil then
		if Current and LoadedTrack == Current and Music.TimeLength > 0 then
			Music.TimePosition = Music.TimeLength * DIGITS[kc] / 10
		end
	end
end)

local accEq, clock, lastSec, posAcc = 0, 0, -1, 0
Bind(RunService.Heartbeat, function(dt)
	clock += dt

	posAcc += dt
	if posAcc >= 4 then
		posAcc = 0
		if Intent and Current and LoadedTrack == Current and Music.TimeLength > 0 then
			Data.LastPos = Music.TimePosition
			SaveSoon()
		end
	end

	for _, f in ipairs(Followers) do
		if f.Active then
			local rate = f.Dragging and CONFIG.Follow or 14
			f.Cur = f.Cur:Lerp(f.Tar, 1 - math.exp(-dt * rate))
			if not f.Dragging and (f.Cur - f.Tar).Magnitude < 0.25 then
				f.Cur = f.Tar
				f.Active = false
			end
			f.Obj.Position = UDim2.fromOffset(f.Cur.X, f.Cur.Y)
		end
	end

	if SleepAt and os.clock() >= SleepAt then
		SleepAt = nil
		if Intent then
			Intent = false
			pcall(function()
				Music:Pause()
			end)
			UpdatePlayState()
		end
		SetStatus("Temporizador finalizado", 2)
	end

	if U.Float.Visible and Intent and Music.IsPlaying then
		local p = (clock * 0.8) % 1
		U.PulseRing.Visible = true
		U.PulseScale.Scale = 1 + p * 0.5
		U.PulseRing.BackgroundTransparency = 0.55 + p * 0.45
	elseif U.PulseRing.Visible then
		U.PulseRing.Visible = false
	end

	if not Open then
		return
	end

	local playing = Intent and Music.IsPlaying
	local loud = 0
	if playing then
		loud = math.clamp(Music.PlaybackLoudness / 350, 0.3, 1)
	end
	for i, b in ipairs(U.VisBars) do
		local target = 3
		if playing then
			local wave = math.sin(clock * (5 + i * 0.9) + i * 1.7) * 0.5 + 0.5
			target = 3 + (0.25 + 0.75 * loud) * (0.35 + 0.65 * wave) * 41
		end
		b.H = b.H + (target - b.H) * math.min(1, dt * 14)
		b.Obj.Size = UDim2.fromOffset(4, math.max(3, math.floor(b.H)))
	end
	local gTarget = playing and (1 + loud * 0.05) or 1
	U.GlowScale.Scale = U.GlowScale.Scale + (gTarget - U.GlowScale.Scale) * math.min(1, dt * 8)
	U.Glow.BackgroundTransparency = playing and (0.93 - loud * 0.07) or 0.95

	if Current and LoadedTrack == Current and Music.TimeLength > 0 and not U.ProgressSlider.Dragging and not U.MiniSlider.Dragging then
		local pos = Music.TimePosition
		local frac = pos / Music.TimeLength
		U.ProgressSlider.Set(frac)
		U.MiniSlider.Set(frac)
		local sec = math.floor(pos)
		if sec ~= lastSec then
			lastSec = sec
			UpdateTimes(pos)
		end
	end

	accEq += dt
	if accEq >= 0.04 then
		accEq = 0
		if Current and Current.UI and Music.IsPlaying and Current.UI.EqFrame.Visible then
			for i, bar in ipairs(Current.UI.Bars) do
				local h = 3 + (math.sin(clock * (6 + i * 2.3) + i) * 0.5 + 0.5) * 11
				bar.Size = UDim2.fromOffset(3, math.floor(h))
			end
		end
	end
end)

