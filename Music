	Tween(U.CoverScale, 0.3, { Scale = Intent and 1 or 0.94 }, Enum.EasingStyle.Quint)
	Tween(U.PlayRing, 0.25, { Transparency = Intent and 0.55 or 1 }, Enum.EasingStyle.Quad)
