		end
		if input.UserInputType == MOUSE1 or input.UserInputType == TOUCH then
			local now = os.clock()
			if now - lastTap < 0.35 then
				lastTap = 0
				ResetWindowSize()
				return
			end
			lastTap = now
			dragging = true
			startInput = input
			startMouse = input.Position
			startScale = U.HolderScale.Scale
			startW, startH = WW, WH
			local c = U.Holder.Position
			startTL = Vector2.new(c.X.Offset - WW * startScale / 2, c.Y.Offset - WH * startScale / 2)
		end
	end)
	Bind(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if input == startInput or (input.UserInputType == Enum.UserInputType.MouseMovement and startInput.UserInputType == MOUSE1) then
			local d = input.Position - startMouse
			local vs = ViewSize()
			local maxW = math.max(DW, (vs.X - 16) / startScale)
			local maxH = math.max(DH, (vs.Y - 24) / startScale)
			local w = math.clamp(startW + d.X / startScale, DW, maxW)
			local h = math.clamp(startH + d.Y / startScale, DH, maxH)
			Relayout(w, h)
			U.Holder.Position = Clamped(startTL.X + WW * startScale / 2, startTL.Y + WH * startScale / 2, HolderHalf())
		end
	end)
	Bind(UserInputService.InputEnded, function(input)
		if not dragging then
			return
		end
		local same = input == startInput or (input.UserInputType == MOUSE1 and startInput.UserInputType == MOUSE1)
		if same then
			dragging = false
			UserScale = U.HolderScale.Scale
			Save()
		end
	end)
end

